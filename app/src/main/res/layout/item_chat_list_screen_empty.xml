<?xml version="1.0" encoding="utf-8"?>
<!-- Empty Chat List State - Matches Compose EmptyChatListState exactly -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Empty State Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_avatar_circle"
            android:contentDescription="@string/empty_chats"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chat"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            app:tint="?attr/glyphTextTertiary" />

        <!-- Empty State Title -->
        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/no_chats_yet"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp" />

        <!-- Empty State Subtitle -->
        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/start_new_conversation"
            android:textColor="?attr/glyphTextSecondary"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>