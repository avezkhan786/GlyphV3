<?xml version="1.0" encoding="utf-8"?>
<!-- Chat List Screen Row Item - Matches Compose ChatRow exactly -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="9dp">

    <!-- Avatar Container - 54dp to match Compose (includes status ring space) -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Circular Profile Photo - 46dp -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            tools:src="@drawable/ic_default_avatar" />

        <!-- Avatar Initial Letter (shown when no image) -->
        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="J"
            tools:visibility="visible" />

        <!-- Status Ring (UNSEEN) - animated ring around avatar -->
        <View
            android:id="@+id/vStatusRing"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_status_ring_unseen"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Online Indicator - positioned at bottom-end of 54dp container -->
        <View
            android:id="@+id/vOnlineIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_online_indicator"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Group Online Count Badge - bottom-end of avatar container -->
        <TextView
            android:id="@+id/tvGroupOnlineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_whatsapp_unread_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="20dp"
            android:minHeight="20dp"
            android:paddingHorizontal="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />

        <!-- Selection Check Overlay - bottom-end when selected -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSelectionCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_selection_check"
            android:contentDescription="Selected"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check_circle_filled"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- Username - Medium weight, 16.5sp -->
    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16.5sp"
        app:layout_constraintBottom_toTopOf="@+id/messageStatusContainer"
        app:layout_constraintEnd_toStartOf="@+id/tvTimestamp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatarContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0"
        tools:text="John Doe" />

    <!-- Timestamp - 12sp, aligned right -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/glyphTextTertiary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvUsername"
        tools:text="10:45 AM" />

    <!-- Message Status + Preview Container -->
    <LinearLayout
        android:id="@+id/messageStatusContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:baselineAligned="true"
        android:baselineAlignedChildIndex="2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/badgeUnread"
        app:layout_constraintStart_toStartOf="@+id/tvUsername"
        app:layout_constraintTop_toBottomOf="@+id/tvUsername">

        <!-- Message Status Icon (clock/sent/delivered/read/failed) -->
        <ImageView
            android:id="@+id/ivMessageStatus"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            app:tint="?attr/glyphTextSecondary"
            tools:src="@drawable/ic_double_check"
            tools:visibility="visible" />

        <!-- Draft Label (shown for drafts) -->
        <TextView
            android:id="@+id/tvDraftLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:includeFontPadding="false"
            android:text="Draft: "
            android:textColor="?attr/colorError"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Last Message Preview - Single line with ellipsis -->
        <!-- tvLastMessage and llTypingIndicator are siblings inside messageStatusContainer,
             both with layout_weight=1 — when one is VISIBLE and the other GONE, the visible
             one occupies the exact same position. Mirrors Compose's Box(weight=1f) containing
             either the last-message Text or the TypingIndicator Row.

             includeFontPadding="false" removes the extra font ascent/descent padding that
             Android TextView adds by default. Compose's Text measures text directly without
             this padding, so disabling it ensures the text bounds — and therefore the text
             vertical position — matches between the XML and Compose paths. -->
        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?attr/glyphTextSecondary"
            android:textSize="14sp"
            tools:text="Hey, are we still meeting today?" />

        <!-- Typing Indicator - replaces tvLastMessage when user is typing.

             gravity="top" (not center_vertical) so the 14sp label is positioned at
             the top of this LinearLayout, matching tvLastMessage's top position.
             Both start at messageStatusContainer's top; with includeFontPadding="false"
             on both, their text baselines align exactly. The 18sp dots are taller and
             start at the same top, extending below — this is a negligible visual offset
             since the dots bounce via translationY animation. -->
        <LinearLayout
            android:id="@+id/llTypingIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTypingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="typing..."
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="italic" />

            <LinearLayout
                android:id="@+id/llTypingDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTypingDot1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="."
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTypingDot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:text="."
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTypingDot3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false"
                    android:text="."
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Unread Badge - Circular, WhatsApp green, 20dp -->
    <!-- Top anchored to messageStatusContainer (which stays at tvUsername.bottom + 2dp even
         when collapsed). Bottom constraint removed — the 20dp badge takes its fixed height
         from the top anchor alone, so it doesn't jump when messageStatusContainer (its
         previous bottom anchor) collapses to 0 height during the typing transition. -->
    <TextView
        android:id="@+id/badgeUnread"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_whatsapp_unread_badge"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/messageStatusContainer"
        tools:text="3"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>